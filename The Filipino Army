<!DOCTYPE html>
<html>
<head>
<title>The Filipino Army | Official Website</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
*{box-sizing:border-box}
body{margin:0;font-family:'Segoe UI',Arial,sans-serif;background:#0a0f08;color:#fff;overflow-x:hidden}
header{background:rgba(20,32,14,0.95);backdrop-filter:blur(10px);padding:14px 22px;display:flex;align-items:center;gap:14px;border-bottom:2px solid #c9a227;position:sticky;top:0;z-index:20}
header h2{margin:0;font-size:20px;letter-spacing:1px}
header span{color:#c9a227}
#menuBtn{background:#c9a227;border:none;padding:9px 15px;font-size:20px;font-weight:900;cursor:pointer;border-radius:8px;color:#000}
#sidebar{position:fixed;left:-300px;top:0;width:285px;height:100%;background:#111d0e;padding-top:70px;transition:left .4s cubic-bezier(.2,.9,.3,1);z-index:100;border-right:2px solid #c9a227}
#sidebar.open{left:0}
#sidebar a{display:block;padding:14px 18px;color:#fff;text-decoration:none;margin:8px 12px;background:#1e2e18;border:1px solid #2a3d1f;border-radius:10px;font-weight:700;transition:.2s}
#sidebar a:hover{background:#c9a227;color:#000;transform:translateX(6px)}
#overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:50}
#overlay.show{display:block}
.page{display:none;opacity:0;transform:translateY(18px);transition:opacity .45s ease,transform .45s ease}
.page.active{display:block;opacity:1;transform:translateY(0)}
.hero{padding:85px 20px 70px;text-align:center;background:radial-gradient(circle at 50% 20%,#2e4a1a 0%,#14200d 60%,#0a0f08 100%);border-bottom:2px solid #c9a227}
.hero small{letter-spacing:4px;color:#c9a227;font-weight:800;font-size:12px}
.hero h1{font-size:52px;margin:10px 0;line-height:0.95;letter-spacing:-1px}
.hero h1 span{color:#c9a227}
.hero p{color:#d6d6d6;max-width:600px;margin:14px auto}
.btn{background:#c9a227;color:#000;border:none;padding:14px 26px;font-weight:900;cursor:pointer;border-radius:30px;font-size:14px;transition:.2s;box-shadow:0 8px 20px rgba(201,162,39,.35)}
.btn:hover{transform:translateY(-2px) scale(1.03)}
.btn2{background:transparent;color:#fff;border:2px solid #fff;padding:12px 24px;font-weight:800;cursor:pointer;border-radius:30px}
.section{padding:36px 20px;max-width:980px;margin:auto}
.section h2{color:#c9a227;font-size:26px;margin-bottom:6px}
.sub{color:#aaa;margin-top:0;margin-bottom:20px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.card{background:linear-gradient(180deg,#1a2913,#121e0c);border:1px solid #2f4a1f;border-radius:16px;padding:20px;transition:.25s}
.card:hover{transform:translateY(-4px);border-color:#c9a227;box-shadow:0 12px 30px rgba(0,0,0,.5)}
.card b{font-size:17px}
.card p{color:#cfd8c5;font-size:14px;line-height:1.6}
.icon{font-size:32px;margin-bottom:10px}
.box{background:#161f11;border:1px solid #2a3d1f;border-left:4px solid #c9a227;padding:16px;margin:12px 0;border-radius:10px;transition:.2s}
.box:hover{transform:translateX(6px)}
table{width:100%;border-collapse:collapse;background:#121e0c;border-radius:12px;overflow:hidden}
th,td{padding:12px;text-align:left;border-bottom:1px solid #2a3d1f}
th{background:#c9a227;color:#000}
input,select,textarea{width:100%;padding:13px;margin:8px 0;background:#141f0f;color:#fff;border:1px solid #2f4a1f;border-radius:10px;outline:none}
input:focus,select:focus,textarea:focus{border-color:#c9a227}
footer{background:#111d0e;text-align:center;padding:20px;margin-top:30px;font-size:13px;color:#aaa;border-top:2px solid #c9a227}
.badge{display:inline-block;background:#c9a227;color:#000;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:900}
</style>
</head>
